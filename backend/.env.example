# Copy to .env and fill in. GATEWAY_DRY_RUN=true means no network/keys needed.

# Master switch: when true, every tier is a deterministic mock (offline tests/demo).
GATEWAY_DRY_RUN=true

# Conformal risk bound (maximum allowed cascade error rate).
GATEWAY_ALPHA=0.05

# Live pilot SQLite path (dashboard + bot logging).
GATEWAY_PILOT_DB=data/pilot.sqlite

# Log every /v1/chat/completions request to the pilot DB (feeds the dashboard).
GATEWAY_LOG_REQUESTS=true

# FX rate for USD -> INR cost reporting.
GATEWAY_FX_RATE_INR_PER_USD=83.5

# CORS origins for the frontend (JSON array or "*" for all).
# GATEWAY_CORS_ORIGINS='["http://localhost:5173"]'

# --- Cheap tier (Groq) ---
GATEWAY_CHEAP__MODEL=llama-3.1-8b-instant
GATEWAY_CHEAP__BASE_URL=https://api.groq.com/openai/v1
GATEWAY_CHEAP__API_KEY=

# --- Premium tier (OpenAI GPT-4o) ---
GATEWAY_PREMIUM__MODEL=gpt-4o
GATEWAY_PREMIUM__BASE_URL=https://api.openai.com/v1
GATEWAY_PREMIUM__API_KEY=

# --- Local compressor model (Qwen via Ollama / vLLM, OpenAI-compatible) ---
GATEWAY_LOCAL__MODEL=qwen3:0.6b
GATEWAY_LOCAL__BASE_URL=http://localhost:11434/v1
GATEWAY_LOCAL__API_KEY=

# Telegram bot (only needed for module 6).
GATEWAY_TELEGRAM_TOKEN=
GATEWAY_TELEGRAM_WEBHOOK_SECRET=
# Public gateway URL for internal Telegram loopback (or direct internal handle in webhook).
GATEWAY_PUBLIC_URL=http://127.0.0.1:8000
# Upstream timeout in seconds (for Groq/OpenAI/Ollama)
GATEWAY_TIMEOUT_S=30.0